{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2020",
    "lib": ["es2020"],
    "declaration": false,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "rootDir": "../..",
    "outDir": "../../dist/apps/api",
    "paths": {
      "@gatas-news/shared-types": ["../../libs/shared/types/src/index.ts"],
      "@gatas-news/shared-utils": ["../../libs/shared/utils/src/index.ts"]
    }
  },
  "exclude": [
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/test/**",
    "../../libs/shared/**/*.test.ts",
    "../../libs/shared/**/*.spec.ts"
  ],
  "include": ["*.ts", "src/**/*.ts", "../../libs/shared/**/*.ts"]
}
